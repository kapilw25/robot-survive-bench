# Copy to .env (gitignored) and fill the keys for the brains you run (step 3).
# The mock brain needs none.

# General frontier brains
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=          # also used by gemini-er2 (robot-specialized)
ZAI_API_KEY=             # GLM
MOONSHOT_API_KEY=        # Kimi
DASHSCOPE_API_KEY=       # Qwen
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=        # Llama

# Robot-specialized brains
NVIDIA_API_KEY=          # Cosmos-Reason1
HF_TOKEN=                # RoboBrain 2.0 (HuggingFace)

# NOTE: git_push.sh uses its own GITHUB_TOKEN_KAPIL / GITHUB_TOKEN_GAYTRI in .env (separate).
