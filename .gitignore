# OS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo

# Secrets - never commit
.env
.env.*
*.pem
*.key

# Claude local (not shared across machines)
.claude/settings.local.json
.claude/state/
.claude/audit/*.jsonl
*.log

# LaTeX build artifacts
*.aux
*.out
*.bbl
*.blg
*.synctex.gz

# Large media (regenerate locally)
media/

# rsbench: envs, caches, build artifacts
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# rsbench: transient run outputs (keep the dir stubs)
data/raw/*
data/ood/*
data/results/*
logs/*
!**/.gitkeep

# keep the env template (overrides the .env.* rule above)
!.env.example

# HF streaming cache (local, not committed)
.hf_cache/
